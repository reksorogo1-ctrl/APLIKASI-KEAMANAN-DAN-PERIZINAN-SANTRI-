rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny all unmapped documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins configuration
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // RBAC User Accounts
    match /users/{userId} {
      allow read, write: if true;
    }

    // Master Santri Data
    match /santri/{santriId} {
      allow read, write: if true;
    }

    // Dewan Keamanan & Piket Data
    match /dewan_keamanan/{dewanId} {
      allow read, write: if true;
    }

    // Perizinan Santri Data
    match /perizinan/{izinId} {
      allow read, write: if true;
    }

    // Catatan Insiden Pelanggaran Data
    match /pelanggaran/{pelanggaranId} {
      allow read, write: if true;
    }

    // Sanksi & Takzir Data
    match /sanksi/{sanksiId} {
      allow read, write: if true;
    }

    // Tata Tertib Qanun Data
    match /tata_tertib/{tataTertibId} {
      allow read, write: if true;
    }

    // Pengaturan Sistem & Option Panel
    match /system_config/{configId} {
      allow read, write: if true;
    }

    // Audit Trail & Logs Aktivitas
    match /logs/{logId} {
      allow read, write: if true;
    }

    // Notifikasi Terpusat
    match /notifikasi/{notifId} {
      allow read, write: if true;
    }

    // Pesan Koordinasi Admin & Pengurus
    match /koordinasi/{koordinasiId} {
      allow read, write: if true;
    }

    // Diagnostic & Connection Test
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
