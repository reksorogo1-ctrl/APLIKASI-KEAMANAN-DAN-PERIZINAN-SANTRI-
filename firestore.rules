rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny all documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'reksorogo1@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admins path
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // Santri collection
    match /santri/{santriId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Perizinan collection
    match /perizinan/{izinId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Pelanggaran collection
    match /pelanggaran/{pelanggaranId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Sanksi collection
    match /sanksi/{sanksiId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Test connection document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
