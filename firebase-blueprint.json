{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account for security personnel and administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nama": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50 },
        "role": { "type": "string" },
        "jabatan": { "type": "string", "maxLength": 100 },
        "statusAktif": { "type": "boolean" },
        "nrp": { "type": "string", "maxLength": 30 },
        "divisi": { "type": "string" },
        "genderAccess": { "type": "string" }
      },
      "required": ["id", "nama", "username", "role", "statusAktif"]
    },
    "Santri": {
      "title": "Santri",
      "description": "Santri profile and identity record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nama": { "type": "string", "maxLength": 120 },
        "nis": { "type": "string", "maxLength": 30 },
        "gender": { "type": "string", "enum": ["putra", "putri"] },
        "kelas": { "type": "string", "maxLength": 50 },
        "kamar": { "type": "string", "maxLength": 50 },
        "namaWali": { "type": "string", "maxLength": 100 },
        "noWaWali": { "type": "string", "maxLength": 30 },
        "poinPelanggaran": { "type": "number" },
        "status": { "type": "string" },
        "suspendIzinHingga": { "type": "string" }
      },
      "required": ["id", "nama", "nis", "gender", "kelas"]
    },
    "DewanKeamanan": {
      "title": "DewanKeamanan",
      "description": "Security officer and guard profiles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nrp": { "type": "string", "maxLength": 30 },
        "nama": { "type": "string", "maxLength": 120 },
        "jabatan": { "type": "string", "maxLength": 100 },
        "divisi": { "type": "string" },
        "statusKeaktifan": { "type": "string" }
      },
      "required": ["id", "nrp", "nama", "jabatan"]
    },
    "Perizinan": {
      "title": "Perizinan",
      "description": "Santri leave and permit clearance record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nomorIzin": { "type": "string", "maxLength": 60 },
        "santriId": { "type": "string" },
        "santriNama": { "type": "string", "maxLength": 120 },
        "santriNis": { "type": "string", "maxLength": 30 },
        "santriGender": { "type": "string", "enum": ["putra", "putri"] },
        "jenisIzin": { "type": "string" },
        "tglKeluar": { "type": "string" },
        "jamKeluar": { "type": "string" },
        "tglKembali": { "type": "string" },
        "jamKembali": { "type": "string" },
        "alasan": { "type": "string", "maxLength": 500 },
        "tujuan": { "type": "string", "maxLength": 200 },
        "status": { "type": "string" },
        "menitKeterlambatan": { "type": "number" }
      },
      "required": ["id", "nomorIzin", "santriId", "santriNama", "jenisIzin", "status"]
    },
    "Pelanggaran": {
      "title": "Pelanggaran",
      "description": "Disciplinary violation incident report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kodePelanggaran": { "type": "string", "maxLength": 50 },
        "santriId": { "type": "string" },
        "santriNama": { "type": "string", "maxLength": 120 },
        "santriNis": { "type": "string", "maxLength": 30 },
        "santriGender": { "type": "string", "enum": ["putra", "putri"] },
        "tanggal": { "type": "string" },
        "jenisPelanggaran": { "type": "string", "maxLength": 255 },
        "kategori": { "type": "string", "enum": ["Ringan", "Sedang", "Berat"] },
        "poin": { "type": "number" },
        "lokasi": { "type": "string", "maxLength": 150 },
        "namaPetugasPelapor": { "type": "string", "maxLength": 100 },
        "statusVerifikasi": { "type": "string" }
      },
      "required": ["id", "santriId", "santriNama", "jenisPelanggaran", "kategori", "poin"]
    },
    "Sanksi": {
      "title": "Sanksi",
      "description": "Educational sanction record for santri",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kodeSanksi": { "type": "string", "maxLength": 60 },
        "santriId": { "type": "string" },
        "santriNama": { "type": "string", "maxLength": 120 },
        "bentukSanksi": { "type": "string", "maxLength": 255 },
        "status": { "type": "string" }
      },
      "required": ["id", "santriId", "santriNama", "status"]
    },
    "TataTertib": {
      "title": "TataTertib",
      "description": "Boarding school rules and discipline code",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kode": { "type": "string" },
        "pasal": { "type": "string" },
        "deskripsi": { "type": "string" },
        "tingkat": { "type": "string" },
        "poin": { "type": "number" }
      },
      "required": ["id", "kode", "deskripsi", "poin"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "Application settings and branding parameters",
      "type": "object",
      "properties": {
        "namaPondok": { "type": "string" },
        "logoUrl": { "type": "string" },
        "bgUrl": { "type": "string" }
      },
      "required": ["namaPondok"]
    },
    "LogAktivitas": {
      "title": "LogAktivitas",
      "description": "Audit trails and activity logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "waktu": { "type": "string" },
        "user": { "type": "string" },
        "aksi": { "type": "string" },
        "detail": { "type": "string" }
      },
      "required": ["id", "waktu", "aksi"]
    },
    "NotifikasiApp": {
      "title": "NotifikasiApp",
      "description": "System broadcast and direct alerts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "waktu": { "type": "string" },
        "judul": { "type": "string" },
        "pesan": { "type": "string" },
        "tipe": { "type": "string" },
        "dibaca": { "type": "boolean" }
      },
      "required": ["id", "judul", "pesan", "dibaca"]
    },
    "PesanKoordinasi": {
      "title": "PesanKoordinasi",
      "description": "Internal coordination and dispatch tickets",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nomorTiket": { "type": "string" },
        "judul": { "type": "string" },
        "isi": { "type": "string" },
        "prioritas": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "nomorTiket", "judul", "isi", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles of officers and administrators"
    },
    "/santri/{santriId}": {
      "schema": { "$ref": "#/entities/Santri" },
      "description": "Registered santri records"
    },
    "/dewan_keamanan/{dewanId}": {
      "schema": { "$ref": "#/entities/DewanKeamanan" },
      "description": "Security council roster"
    },
    "/perizinan/{izinId}": {
      "schema": { "$ref": "#/entities/Perizinan" },
      "description": "Active and archived permits"
    },
    "/pelanggaran/{pelanggaranId}": {
      "schema": { "$ref": "#/entities/Pelanggaran" },
      "description": "Disciplinary violations"
    },
    "/sanksi/{sanksiId}": {
      "schema": { "$ref": "#/entities/Sanksi" },
      "description": "Educational sanctions"
    },
    "/tata_tertib/{tataTertibId}": {
      "schema": { "$ref": "#/entities/TataTertib" },
      "description": "Pondok code of conduct"
    },
    "/system_config/{configId}": {
      "schema": { "$ref": "#/entities/SystemConfig" },
      "description": "Global application configuration"
    },
    "/logs/{logId}": {
      "schema": { "$ref": "#/entities/LogAktivitas" },
      "description": "System activity logs"
    },
    "/notifikasi/{notifId}": {
      "schema": { "$ref": "#/entities/NotifikasiApp" },
      "description": "App notification inbox"
    },
    "/koordinasi/{koordinasiId}": {
      "schema": { "$ref": "#/entities/PesanKoordinasi" },
      "description": "Command coordination messages"
    }
  }
}
