{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account for security personnel and administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nama": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50 },
        "role": { "type": "string" },
        "jabatan": { "type": "string", "maxLength": 100 },
        "statusAktif": { "type": "boolean" },
        "nrp": { "type": "string", "maxLength": 30 },
        "divisi": { "type": "string" },
        "genderAccess": { "type": "string" },
        "murotilKelompokIds": { "type": "array" }
      },
      "required": ["id", "nama", "username", "role", "statusAktif"]
    },
    "Santri": {
      "title": "Santri",
      "description": "Santri profile and identity record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nama": { "type": "string", "maxLength": 120 },
        "nis": { "type": "string", "maxLength": 30 },
        "gender": { "type": "string", "enum": ["putra", "putri"] },
        "kelas": { "type": "string", "maxLength": 50 },
        "kamar": { "type": "string", "maxLength": 50 },
        "namaWali": { "type": "string", "maxLength": 100 },
        "noWaWali": { "type": "string", "maxLength": 30 },
        "poinPelanggaran": { "type": "number" },
        "status": { "type": "string" },
        "suspendIzinHingga": { "type": "string" }
      },
      "required": ["id", "nama", "nis", "gender", "kelas"]
    },
    "DewanKeamanan": {
      "title": "DewanKeamanan",
      "description": "Security officer and guard profiles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nrp": { "type": "string", "maxLength": 30 },
        "nama": { "type": "string", "maxLength": 120 },
        "jabatan": { "type": "string", "maxLength": 100 },
        "divisi": { "type": "string" },
        "statusKeaktifan": { "type": "string" }
      },
      "required": ["id", "nrp", "nama", "jabatan"]
    },
    "Perizinan": {
      "title": "Perizinan",
      "description": "Santri leave and permit clearance record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nomorIzin": { "type": "string", "maxLength": 60 },
        "santriId": { "type": "string" },
        "santriNama": { "type": "string", "maxLength": 120 },
        "santriNis": { "type": "string", "maxLength": 30 },
        "santriGender": { "type": "string", "enum": ["putra", "putri"] },
        "jenisIzin": { "type": "string" },
        "tglKeluar": { "type": "string" },
        "jamKeluar": { "type": "string" },
        "tglKembali": { "type": "string" },
        "jamKembali": { "type": "string" },
        "alasan": { "type": "string", "maxLength": 500 },
        "tujuan": { "type": "string", "maxLength": 200 },
        "status": { "type": "string" },
        "menitKeterlambatan": { "type": "number" }
      },
      "required": ["id", "nomorIzin", "santriId", "santriNama", "jenisIzin", "status"]
    },
    "Pelanggaran": {
      "title": "Pelanggaran",
      "description": "Disciplinary violation incident report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kodePelanggaran": { "type": "string", "maxLength": 50 },
        "santriId": { "type": "string" },
        "santriNama": { "type": "string", "maxLength": 120 },
        "santriNis": { "type": "string", "maxLength": 30 },
        "santriGender": { "type": "string", "enum": ["putra", "putri"] },
        "tanggal": { "type": "string" },
        "jenisPelanggaran": { "type": "string", "maxLength": 255 },
        "kategori": { "type": "string", "enum": ["Ringan", "Sedang", "Berat"] },
        "poin": { "type": "number" },
        "lokasi": { "type": "string", "maxLength": 150 },
        "namaPetugasPelapor": { "type": "string", "maxLength": 100 },
        "statusVerifikasi": { "type": "string" }
      },
      "required": ["id", "santriId", "santriNama", "jenisPelanggaran", "kategori", "poin"]
    },
    "Sanksi": {
      "title": "Sanksi",
      "description": "Educational sanction record for santri",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kodeSanksi": { "type": "string", "maxLength": 60 },
        "santriId": { "type": "string" },
        "santriNama": { "type": "string", "maxLength": 120 },
        "bentukSanksi": { "type": "string", "maxLength": 255 },
        "status": { "type": "string" }
      },
      "required": ["id", "santriId", "santriNama", "status"]
    },
    "TataTertib": {
      "title": "TataTertib",
      "description": "Boarding school rules and discipline code",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kode": { "type": "string" },
        "pasal": { "type": "string" },
        "deskripsi": { "type": "string" },
        "tingkat": { "type": "string" },
        "poin": { "type": "number" }
      },
      "required": ["id", "kode", "deskripsi", "poin"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "Application settings and branding parameters",
      "type": "object",
      "properties": {
        "namaPondok": { "type": "string" },
        "logoUrl": { "type": "string" },
        "bgUrl": { "type": "string" },
        "fasilitasGedungList": { "type": "array" },
        "perlengkapanConfig": { "type": "object" },
        "pusatInformasiList": { "type": "array" },
        "murotilTingkatanList": { "type": "array" },
        "murotilKelompokList": { "type": "array" },
        "murotilAbsensiSantriList": { "type": "array" },
        "murotilSetoranList": { "type": "array" },
        "murotilAbsensiPjList": { "type": "array" },
        "murotilConfig": { "type": "object" }
      },
      "required": ["namaPondok"]
    },
    "LogAktivitas": {
      "title": "LogAktivitas",
      "description": "Audit trails and activity logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "waktu": { "type": "string" },
        "user": { "type": "string" },
        "aksi": { "type": "string" },
        "detail": { "type": "string" }
      },
      "required": ["id", "waktu", "aksi"]
    },
    "NotifikasiApp": {
      "title": "NotifikasiApp",
      "description": "System broadcast and direct alerts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "waktu": { "type": "string" },
        "judul": { "type": "string" },
        "pesan": { "type": "string" },
        "tipe": { "type": "string" },
        "dibaca": { "type": "boolean" }
      },
      "required": ["id", "judul", "pesan", "dibaca"]
    },
    "PesanKoordinasi": {
      "title": "PesanKoordinasi",
      "description": "Internal coordination and dispatch tickets",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nomorTiket": { "type": "string" },
        "judul": { "type": "string" },
        "isi": { "type": "string" },
        "prioritas": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "nomorTiket", "judul", "isi", "status"]
    },
    "StrukturOrganisasiNode": {
      "title": "StrukturOrganisasiNode",
      "description": "Organizational hierarchy node for Pesantren management",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "jabatan": { "type": "string", "maxLength": 120 },
        "namaPengurus": { "type": "string", "maxLength": 120 },
        "divisi": { "type": "string" },
        "level": { "type": "number" },
        "periode": { "type": "string" },
        "statusAktif": { "type": "boolean" }
      },
      "required": ["id", "jabatan", "namaPengurus", "divisi"]
    },
    "AgendaPengurus": {
      "title": "AgendaPengurus",
      "description": "Management schedule and activities overseen by Ketua Pondok",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "judul": { "type": "string", "maxLength": 200 },
        "tanggal": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "judul", "tanggal", "status"]
    },
    "EvaluasiKepengurusan": {
      "title": "EvaluasiKepengurusan",
      "description": "Board evaluation notes by Ketua Pondok",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tanggal": { "type": "string" },
        "divisi": { "type": "string" },
        "judul": { "type": "string", "maxLength": 200 },
        "nilaiKinerja": { "type": "string" }
      },
      "required": ["id", "tanggal", "divisi", "judul"]
    },
    "PengajuanDivisi": {
      "title": "PengajuanDivisi",
      "description": "Division reports and approval requests to Ketua Pondok",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nomorPengajuan": { "type": "string" },
        "divisi": { "type": "string" },
        "judul": { "type": "string", "maxLength": 200 },
        "status": { "type": "string" }
      },
      "required": ["id", "nomorPengajuan", "divisi", "judul", "status"]
    },
    "ArsipSurat": {
      "title": "ArsipSurat",
      "description": "Official correspondence archive (15 letter types) managed by Sekretaris",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "arah": { "type": "string", "enum": ["Keluar", "Masuk"] },
        "kodeJenis": { "type": "string" },
        "nomorSurat": { "type": "string", "maxLength": 100 },
        "tanggalSurat": { "type": "string" },
        "perihal": { "type": "string", "maxLength": 255 },
        "status": { "type": "string" }
      },
      "required": ["id", "arah", "kodeJenis", "nomorSurat", "perihal"]
    },
    "TransaksiKeuangan": {
      "title": "TransaksiKeuangan",
      "description": "Income and expense ledger entries managed by Bendahara",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kodeTransaksi": { "type": "string" },
        "tanggal": { "type": "string" },
        "tipe": { "type": "string", "enum": ["Pemasukan", "Pengeluaran"] },
        "kategori": { "type": "string" },
        "nominal": { "type": "number" }
      },
      "required": ["id", "kodeTransaksi", "tanggal", "tipe", "nominal"]
    },
    "BarangInventaris": {
      "title": "BarangInventaris",
      "description": "Inventory assets managed by Perlengkapan division",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kodeBarang": { "type": "string" },
        "namaBarang": { "type": "string", "maxLength": 150 },
        "kategori": { "type": "string" },
        "jumlah": { "type": "number" },
        "kondisi": { "type": "string" }
      },
      "required": ["id", "kodeBarang", "namaBarang", "jumlah"]
    },
    "PeminjamanBarang": {
      "title": "PeminjamanBarang",
      "description": "Equipment borrowing and return logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kodePeminjaman": { "type": "string" },
        "barangId": { "type": "string" },
        "peminjamNama": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "kodePeminjaman", "barangId", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles of officers and administrators"
    },
    "/santri/{santriId}": {
      "schema": { "$ref": "#/entities/Santri" },
      "description": "Registered santri records"
    },
    "/dewan_keamanan/{dewanId}": {
      "schema": { "$ref": "#/entities/DewanKeamanan" },
      "description": "Security council roster"
    },
    "/perizinan/{izinId}": {
      "schema": { "$ref": "#/entities/Perizinan" },
      "description": "Active and archived permits"
    },
    "/pelanggaran/{pelanggaranId}": {
      "schema": { "$ref": "#/entities/Pelanggaran" },
      "description": "Disciplinary violations"
    },
    "/sanksi/{sanksiId}": {
      "schema": { "$ref": "#/entities/Sanksi" },
      "description": "Educational sanctions"
    },
    "/tata_tertib/{tataTertibId}": {
      "schema": { "$ref": "#/entities/TataTertib" },
      "description": "Pondok code of conduct"
    },
    "/system_config/{configId}": {
      "schema": { "$ref": "#/entities/SystemConfig" },
      "description": "Global application configuration"
    },
    "/logs/{logId}": {
      "schema": { "$ref": "#/entities/LogAktivitas" },
      "description": "System activity logs"
    },
    "/notifikasi/{notifId}": {
      "schema": { "$ref": "#/entities/NotifikasiApp" },
      "description": "App notification inbox"
    },
    "/koordinasi/{koordinasiId}": {
      "schema": { "$ref": "#/entities/PesanKoordinasi" },
      "description": "Command coordination messages"
    },
    "/struktur_organisasi/{nodeId}": {
      "schema": { "$ref": "#/entities/StrukturOrganisasiNode" },
      "description": "Pesantren organizational structure nodes"
    },
    "/agenda_pengurus/{agendaId}": {
      "schema": { "$ref": "#/entities/AgendaPengurus" },
      "description": "Management agendas and activities"
    },
    "/evaluasi_kepengurusan/{evaluasiId}": {
      "schema": { "$ref": "#/entities/EvaluasiKepengurusan" },
      "description": "Ketua Pondok division evaluations"
    },
    "/pengajuan_divisi/{pengajuanId}": {
      "schema": { "$ref": "#/entities/PengajuanDivisi" },
      "description": "Division approval requests and periodic reports"
    },
    "/surat_menyurat/{suratId}": {
      "schema": { "$ref": "#/entities/ArsipSurat" },
      "description": "Official letters and correspondence archive"
    },
    "/keuangan_transaksi/{transaksiId}": {
      "schema": { "$ref": "#/entities/TransaksiKeuangan" },
      "description": "Financial cashbook income and expense transactions"
    },
    "/perlengkapan_inventaris/{barangId}": {
      "schema": { "$ref": "#/entities/BarangInventaris" },
      "description": "Pesantren inventory and facility assets"
    },
    "/perlengkapan_peminjaman/{peminjamanId}": {
      "schema": { "$ref": "#/entities/PeminjamanBarang" },
      "description": "Equipment borrowing records"
    }
  }
}
